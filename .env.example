# Base URL of accounting-api, no trailing slash.
# BUILD-TIME variable: Vite inlines it into the JS bundle when the app is built, so
# changing it requires a rebuild (and the build fails if it is missing).
# Local development:
VITE_API_URL="http://localhost:3000"
# Production (set as a Docker build argument / Coolify build variable, not here):
#   VITE_API_URL=https://api.exin-finance.sam-trek.com
